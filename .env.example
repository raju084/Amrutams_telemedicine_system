# ==============================================================================
# Amrutam Telemedicine Backend - Environment Variables
# ==============================================================================

# Django Core
DEBUG=False
SECRET_KEY=django-insecure-amrutam-production-grade-super-strong-secret-key-change-in-prod!
ALLOWED_HOSTS=localhost,127.0.0.1,backend,amrutam.com,*.amrutam.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://amrutam.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amrutam_db
DB_USER=amrutam_user
DB_PASSWORD=amrutam_secure_password_2026
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis & Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Celery & Message Broker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & Encryption (AES-256 GCM 32-byte Base64 key for PHI data encryption)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=s8zP9kL0jXy3mQ1vT4wZ6aB8cE0gI2kM4oP6rS8uW0Y=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# MFA Issuer Name
MFA_ISSUER=AmrutamAyurveda

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=True
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
LOG_LEVEL=INFO

# Razorpay Payment Gateway
# Generate Webhook Secret from Razorpay Dashboard > Webhooks > Edit > Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Notifications: 'log' (dev), 'ses', or 'sendgrid'
NOTIFICATION_PROVIDER=log
NOTIFICATION_FROM_EMAIL=noreply@amrutam.com

# AWS SES (required when NOTIFICATION_PROVIDER=ses)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1

# SendGrid (required when NOTIFICATION_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Read-Replica Database (optional — offloads analytics queries)
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
